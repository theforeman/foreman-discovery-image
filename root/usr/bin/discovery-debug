#!/bin/bash

source /etc/default/discovery
export FACTERLIB

echo "* LIVE FILESYSTEM MOUNTS *"
findmnt -o TARGET,SOURCE,FSTYPE,OPTIONS

echo "* KERNEL COMMAND LINE *"
cat /proc/cmdline

echo "* EFFECTIVE FDI COMMAND LINE *"
discovery-cmdline

echo "* PROCESSES *"
ps axww

echo "* PACKAGES"
cat /usr/PACKAGES-LIST

echo "* NETWORK CONFIGURATION *"
nmcli con
for C in /etc/NetworkManager/system-connections/*; do
  [ -f "$C" ] || continue
  echo "$C"; cat "$C"; echo
done

echo "* IP ADDRESSES *"
ip addr show

echo "* ROUTES *"
ip route

echo "* NEIGHBOURS *"
ip neigh

echo "* DHCP LEASES *"
nmcli -f GENERAL.DEVICE,DHCP4,DHCP6 device show

echo "* DNS *"
cat /etc/resolv.conf

echo "* IMAGE VERSION"
cat /usr/share/fdi/VERSION /usr/share/fdi/RELEASE

echo "* FACTER *"
facter --json

echo "* JOURNAL (last 500 lines) *"
journalctl -n500 -ocat
